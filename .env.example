# Apify/Airtable credentials (Apify token, Airtable token/base) are still
# submitted per-request through the console form — never put those here.
# These three are the only real secrets this app needs: they identify your
# Supabase project (accounts + per-user data). Get them from your Supabase
# project's Settings -> API page.

PORT=3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
