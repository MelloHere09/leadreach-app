# Apify/Airtable credentials (Apify token, Airtable token/base) are still
# submitted per-request through the console form — never put those here.

PORT=3000

# Identify your Supabase project (accounts + per-user data). Get them from
# your Supabase project's Settings -> API page.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Lemon Squeezy: Settings -> Webhooks for the signing secret, and each
# product's variant page for its numeric variant ID.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STARTER_VARIANT_ID=
LEMONSQUEEZY_GROWTH_VARIANT_ID=
